---
import { Image } from "astro:assets";
import { t, type Locale } from "../translations";
import { getIcon } from "../utils/icons";
import { parseDate } from "../utils/date";
import { getCalendarLinks, getMapsUrl } from "../utils/calendar";
import type { Event } from "../content.config";
import AddToCalendar from "./AddToCalendar.svelte";

interface Props {
	locale: Locale;
	event: Event;
	index: number;
	disabledCalendar?: boolean;
}

const { event, locale, index, disabledCalendar } = Astro.props;

const isLocalImage = typeof event.image !== "string";

const getMonth = (dateString: string): string => {
	const date = parseDate(dateString);
	const month = date.getMonth();
	return t(locale, "date.months." + month);
};

const getDateNumber = (dateString: string): number => {
	const date = parseDate(dateString);
	return date.getDate();
};

const getTime = (dateString: string): string => {
	const date = parseDate(dateString);
	const hours = date.getHours();
	const minutes = date.getMinutes();
	return `${hours}:${minutes.toString().padStart(2, "0")}`;
};

const getTwoLastNumberOfYear = (dateString: string): number => {
	const date = parseDate(dateString);
	return date.getFullYear() % 100;
};

const isSameDay = (dateStringA: string, dateStringB: string): boolean => {
	const a = parseDate(dateStringA);
	const b = parseDate(dateStringB);
	return (
		a.getFullYear() === b.getFullYear() &&
		a.getMonth() === b.getMonth() &&
		a.getDate() === b.getDate()
	);
};

const getShortDate = (dateString: string): string => {
	return `${getDateNumber(dateString)} ${getMonth(dateString)}`;
};

const MapPin = getIcon("mapPin");
const Clock = getIcon("clock");
const ArrowRight = getIcon("arrow-right");
const Navigation = getIcon("navigation");

const url = event.url;
const hasUrl = !!url;
const sameDay = isSameDay(event.dateStart, event.dateEnd);

const mapsUrl = getMapsUrl(event);
const calendarLinks = getCalendarLinks(event);

const accentColors = [
	{
		gradient: "from-brand-pink-500 to-brand-purple-600",
		border: "border-brand-pink-500/30",
		text: "text-brand-pink-400",
		hoverText: "hover:text-brand-pink-300",
	},
	{
		gradient: "from-brand-cyan-400 to-brand-blue-600",
		border: "border-brand-cyan-400/30",
		text: "text-brand-cyan-400",
		hoverText: "hover:text-brand-cyan-400",
	},
	{
		gradient: "from-brand-amber-400 to-brand-orange-600",
		border: "border-brand-amber-400/30",
		text: "text-brand-amber-400",
		hoverText: "hover:text-brand-amber-400",
	},
	{
		gradient: "from-brand-emerald-400 to-brand-teal-600",
		border: "border-brand-emerald-400/30",
		text: "text-brand-emerald-400",
		hoverText: "hover:text-brand-emerald-400",
	},
];
const accent = accentColors[index % accentColors.length];
---

<article
	class="group relative bg-surface-card backdrop-blur-sm rounded-2xl overflow-hidden border border-border-default transition-all duration-300 block"
>
	<div class="flex flex-col md:flex-row items-stretch">
		{/* Date column */}
		<div
			class:list={[
				"text-center gap-2 md:gap-1 md:w-24 flex md:flex-col items-center justify-center p-4 bg-linear-to-br text-text-primary",
				accent.gradient,
			]}
		>
			<div class="text-3xl md:text-4xl font-bold">
				{getDateNumber(event.dateStart)}
			</div>
			<div class="text-1xl md:text-base uppercase tracking-wider">
				{getMonth(event.dateStart)}
			</div>
			<div class="text-3xl md:text-4xl font-black">
				{getTwoLastNumberOfYear(event.dateStart)}
			</div>
		</div>

		{/* Content column */}
		<div class="flex-1 flex flex-col md:flex-row">
			<div class="flex-1 p-4 md:p-5 flex flex-col">
				{/* Title */}
				<h3
					class="text-xl md:text-2xl text-text-primary mb-3 font-semibold leading-tight"
				>
					{event.title}
				</h3>

				{/* Info rows */}
				<div class="space-y-2 mb-4">
					{/* Location — clickable, opens in maps */}
					<a
						href={mapsUrl}
						target="_blank"
						rel="noopener noreferrer"
						class:list={[
							"inline-flex items-center gap-2 text-text-muted text-sm transition-colors rounded-md -ml-1 px-1 py-0.5",
							`hover:${accent.text}`,
							"hover:text-brand-pink-400",
						]}
						aria-label={`${event.location}, ${event.city}, ${event.country} — ${t(locale, "events.openMap")}`}
					>
						<MapPin class="w-4 h-4 shrink-0" />
						<span
							class="underline decoration-dotted underline-offset-2"
						>
							{event.location}, {event.city}, {event.country}
						</span>
						<Navigation
							class="w-3 h-3 shrink-0 opacity-0 group-hover:opacity-60 transition-opacity"
						/>
					</a>

					{/* Time */}
					<div
						class="flex items-center gap-2 text-text-muted text-sm"
					>
						<Clock class:list={["w-4 h-4 shrink-0", accent.text]} />
						{
							sameDay ? (
								<span>
									{getTime(event.dateStart)} –{" "}
									{getTime(event.dateEnd)}
								</span>
							) : (
								<span>
									{getTime(event.dateStart)}{" "}
									<span class="text-text-faint">
										({getShortDate(event.dateStart)})
									</span>{" "}
									– {getTime(event.dateEnd)}{" "}
									<span class="text-text-faint">
										({getShortDate(event.dateEnd)})
									</span>
								</span>
							)
						}
					</div>
				</div>

				{/* Action buttons */}
				<div class="flex flex-wrap items-center gap-3 mt-auto pt-2">
					{/* Add to Calendar */}
					{
						!disabledCalendar && (
							<AddToCalendar
								client:visible
								links={calendarLinks}
								labelAdd={t(locale, "events.addCalendar")}
								labelGoogle={t(locale, "events.googleCalendar")}
								labelApple={t(locale, "events.appleCalendar")}
								labelOutlook={t(
									locale,
									"events.outlookCalendar",
								)}
							/>
						)
					}
					{/* View Details link — only if event has a URL */}
					{
						hasUrl && (
							<a
								href={url}
								target="_blank"
								rel="noopener noreferrer"
								class:list={[
									"inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg transition-all duration-200",
									`bg-linear-to-r ${accent.gradient} text-text-primary hover:opacity-90 shadow-md hover:shadow-lg`,
								]}
							>
								<span>{t(locale, "events.details")}</span>
								<ArrowRight class="w-4 h-4" />
							</a>
						)
					}
				</div>
			</div>

			{/* Image */}
			<div class="md:w-48 h-48 md:h-auto relative overflow-hidden">
				{
					isLocalImage ? (
						<Image
							src={event.image}
							alt={event.title}
							widths={[192, 384]}
							sizes="(min-width: 768px) 192px, 100vw"
							class="w-full h-full object-cover"
							loading="lazy"
							decoding="async"
						/>
					) : (
						<img
							src={event.image}
							alt={event.title}
							class="w-full h-full object-cover"
							loading="lazy"
							decoding="async"
						/>
					)
				}
				<div
					class="absolute inset-0 bg-linear-to-br from-surface-card-solid/80 to-transparent md:from-transparent md:to-surface-card-solid/0"
				>
				</div>
			</div>
		</div>
	</div>

	{/* Accent bar */}
	<div
		class:list={[
			`absolute bottom-0 left-0 right-0 h-1 bg-linear-to-br ${accent.gradient} origin-left`,
		]}
	>
	</div>
</article>
