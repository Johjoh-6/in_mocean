---
import { Image } from "astro:assets";
import { t, type Locale } from "../translations";
import { getIcon } from "../utils/icons";
import type { Event } from "../content.config";

interface Props {
	locale: Locale;
	event: Event;
	index: number;
}

const { event, locale, index } = Astro.props;

const isLocalImage = typeof event.image !== "string";

const getMonth = (dateString: string): string => {
	const date = new Date(dateString);
	const month = date.getMonth();
	return t(locale, "date.months." + month);
};

const getDateNumber = (dateString: string): number => {
	const date = new Date(dateString);
	return date.getDate();
};

const getTime = (dateString: string): string => {
	const date = new Date(dateString);
	const hours = date.getHours();
	const minutes = date.getMinutes();
	return `${hours}:${minutes.toString().padStart(2, "0")}`;
};

const getTwoLastNumberOfYear = (dateString: string): number => {
	const date = new Date(dateString);
	return date.getFullYear() % 100;
};

const isSameDay = (dateStringA: string, dateStringB: string): boolean => {
	const a = new Date(dateStringA);
	const b = new Date(dateStringB);
	return (
		a.getFullYear() === b.getFullYear() &&
		a.getMonth() === b.getMonth() &&
		a.getDate() === b.getDate()
	);
};

const getShortDate = (dateString: string): string => {
	return `${getDateNumber(dateString)} ${getMonth(dateString)}`;
};

const MapPin = getIcon("mapPin");
const Clock = getIcon("clock");
const ArrowRight = getIcon("arrow-right");

const url = event.url;
const hasUrl = !!url;
const Tag = hasUrl ? "a" : "div";
const sameDay = isSameDay(event.dateStart, event.dateEnd);

const accentColors = [
	{
		gradient: "from-pink-500 to-purple-600",
		border: "hover:border-pink-500/50",
	},
	{
		gradient: "from-cyan-400 to-blue-600",
		border: "hover:border-cyan-400/50",
	},
	{
		gradient: "from-amber-400 to-orange-600",
		border: "hover:border-amber-400/50",
	},
	{
		gradient: "from-emerald-400 to-teal-600",
		border: "hover:border-emerald-400/50",
	},
];
const accent = accentColors[index % accentColors.length];
---

<Tag
	class:list={[
		"group relative bg-slate-900/50 backdrop-blur-sm rounded-2xl overflow-hidden border border-slate-800 transition-all duration-300 block",
		hasUrl ? `${accent.border} cursor-pointer` : "border-slate-800/60",
	]}
	{...hasUrl ? { href: url, target: "_blank" } : {}}
>
	<div class="flex flex-col md:flex-row items-stretch">
		<div
			class="md:w-24 flex md:flex-col items-center justify-center p-4 bg-linear-to-br from-pink-500 to-purple-600 text-white"
		>
			<div class="text-center">
				<div class="text-3xl md:text-4xl font-bold mb-1">
					{getDateNumber(event.dateStart)}
				</div>
				<div class="text-xs md:text-sm uppercase tracking-wider mb-1">
					{getMonth(event.dateStart)}
				</div>
				<div class="text-3xl md:text-4xl font-black">
					{getTwoLastNumberOfYear(event.dateStart)}
				</div>
			</div>
		</div>

		<div class="flex-1 flex flex-col md:flex-row">
			<div class="flex-1 p-4 md:p-5">
				<h3
					class:list={[
						"text-xl md:text-2xl text-white mb-3 transition-colors",
						hasUrl && "group-hover:text-pink-400",
					]}
				>
					{event.title}
				</h3>

				<div class="space-y-2 mb-4">
					<div class="flex items-center gap-2 text-gray-400 text-sm">
						<MapPin class="w-4 h-4 text-pink-400 shrink-0" />
						<span
							>{event.location}, {event.city}, {
								event.country
							}</span
						>
					</div>
					<div class="flex items-center gap-2 text-gray-400 text-sm">
						<Clock class="w-4 h-4 text-pink-400 shrink-0" />
						{
							sameDay ? (
								<span>
									{getTime(event.dateStart)} –{" "}
									{getTime(event.dateEnd)}
								</span>
							) : (
								<span>
									{getTime(event.dateStart)}{" "}
									<span class="text-gray-500">
										({getShortDate(event.dateStart)})
									</span>{" "}
									– {getTime(event.dateEnd)}{" "}
									<span class="text-gray-500">
										({getShortDate(event.dateEnd)})
									</span>
								</span>
							)
						}
					</div>
				</div>

				{
					hasUrl && (
						<p class="flex items-center gap-2 text-pink-400 hover:text-pink-300 transition-colors group text-sm">
							<span>{t(locale, "events.details")}</span>
							<ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
						</p>
					)
				}
			</div>

			<div class="md:w-48 h-32 md:h-auto relative overflow-hidden">
				{
					isLocalImage ? (
						<Image
							src={event.image}
							alt={event.title}
							widths={[192, 384]}
							sizes="(min-width: 768px) 192px, 100vw"
							class="w-full h-full object-cover"
							loading="lazy"
							decoding="async"
						/>
					) : (
						<img
							src={event.image}
							alt={event.title}
							class="w-full h-full object-cover"
							loading="lazy"
							decoding="async"
						/>
					)
				}
				<div
					class="absolute inset-0 bg-linear-to-br from-slate-900/80 to-transparent md:from-transparent md:to-slate-900/0"
				>
				</div>
			</div>
		</div>
	</div>

	<div
		class:list={[
			`absolute bottom-0 left-0 right-0 h-1 bg-linear-to-br ${accent.gradient} origin-left`,
			!hasUrl && "opacity-40",
		]}
	>
	</div>
</Tag>
