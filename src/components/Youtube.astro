---
import { getCollection } from "astro:content";
import { t, type Locale } from "../translations";
import { getIcon } from "../utils/icons";
import { getSocialLinkByName } from "../data";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const videoEntries = await getCollection("youtube");
const videos = videoEntries.map((entry) => ({
  id: entry.id,
  ...entry.data,
}));

const hasVideos = videos.length > 0;

function formatDate(dateString: string): string {
  const date = new Date(dateString);
  return date.toLocaleDateString(locale, {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });
}

const PlayIcon = getIcon('play');
const EyeIcon = getIcon('eye');
const YoutubeIcon = getIcon('youtube');

const YoutubeUrl = getSocialLinkByName("youtube")?.href || "";
---

<section
  id="videos"
  class="relative py-20 bg-surface-section"
  aria-labelledby="videos-title"
>
  <!-- Simple Background Pattern -->
  <div class="absolute inset-0 opacity-5">
    <div
      class="absolute inset-0"
      style={`background-image: radial-gradient(circle at 25% 25%, var(--brand-red-500) 1px, transparent 1px), radial-gradient(circle at 75% 75%, var(--brand-orange-500) 1px, transparent 1px); background-size: 50px 50px;`}
    ></div>
  </div>

  <div class="container mx-auto px-4 lg:px-8 relative z-10">
    <div class="max-w-6xl mx-auto">
      <!-- Header -->
      <header class="text-center mb-16">
        <h2
          id="videos-title"
          class="text-4xl md:text-5xl lg:text-6xl mb-6 gradient-youtube-heading font-bold leading-tight"
        >
          {t(locale, "youtube.title")}
        </h2>
        <p class="text-text-muted text-lg lg:text-xl mb-8 max-w-2xl mx-auto leading-relaxed">
          {t(locale, "youtube.subtitle")}
        </p>
      </header>

      {!hasVideos ? (
        <!-- Empty State -->
        <div class="text-center py-12">
          <div class="bg-surface-card border border-border-muted rounded-lg p-6 max-w-md mx-auto mb-8">
            <p class="text-text-secondary mb-2">No videos found.</p>
            <p class="text-text-muted text-sm">Check that YOUTUBE_API_KEY and YOUTUBE_CHANNEL_ID are configured.</p>
          </div>

          <a
            href={YoutubeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-8 py-4 bg-linear-to-r from-brand-red-500 to-brand-orange-500 hover:from-brand-red-600 hover:to-brand-orange-600 text-text-primary rounded-full transition-all duration-300 font-medium transform hover:scale-105 shadow-lg shadow-brand-red-500/25"
            aria-label="Visit YouTube channel"
          >
            <YoutubeIcon class="w-6 h-6" aria-hidden="true" />
            <span>{t(locale, "youtube.button")}</span>
          </a>
        </div>
      ) : (
        <!-- Videos Grid -->
        <>
          <div class="grid md:grid-cols-2 gap-8 mb-16">
            {videos.map((video) => (
              <article class="group bg-surface-card backdrop-blur-sm rounded-xl overflow-hidden border border-border-default hover:border-brand-red-500/50 transition-all duration-300 transform hover:-translate-y-1">
                <!-- Thumbnail -->
                <div class="relative aspect-video overflow-hidden">
                  <img
                    src={video.thumbnail}
                    alt={`${video.title} thumbnail`}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />

                  <!-- Gradient Overlay -->
                  <div class="absolute inset-0 bg-linear-to-t from-surface-card-solid via-surface-card-solid/50 to-transparent"></div>

                  <!-- Play Button -->
                  <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <a
                      href={`https://www.youtube.com/watch?v=${video.id}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-16 h-16 bg-brand-red-600 hover:bg-brand-red-500 rounded-full flex items-center justify-center transform hover:scale-110 transition-all duration-300 shadow-2xl"
                      aria-label={`Play ${video.title}`}
                    >
                      <PlayIcon class="w-8 h-8 text-text-primary ml-1" fill="currentColor" />
                    </a>
                  </div>

                  <!-- Duration Badge -->
                  <div class="absolute bottom-4 right-4 bg-black/80 text-text-primary px-2 py-1 rounded text-sm font-medium">
                    {video.duration}
                  </div>

                  <!-- Upload Date -->
                  <div class="absolute top-4 left-4 bg-black/80 text-text-primary px-2 py-1 rounded text-xs">
                    {formatDate(video.publishedAt)}
                  </div>
                </div>

                <!-- Video Info -->
                <div class="p-6">
                  <h3 class="text-xl text-text-primary font-semibold mb-3 group-hover:text-brand-red-400 transition-colors leading-tight">
                    {video.title}
                  </h3>

                  <p class="text-text-muted text-sm mb-4 line-clamp-2 leading-relaxed">
                    {video.description}
                  </p>

                  <div class="flex items-center justify-between text-sm text-text-faint">
                    <div class="flex items-center gap-1">
                      <EyeIcon class="w-4 h-4" aria-hidden="true" />
                      <span>{video.views} views</span>
                    </div>

                    {video.likes && (
                      <div class="flex items-center gap-1">
                        <span>👍</span>
                        <span>{video.likes}</span>
                      </div>
                    )}
                  </div>
                </div>
              </article>
            ))}
          </div>

          <!-- YouTube Channel Link -->
          <div class="text-center">
            <a
              href={YoutubeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-3 px-8 py-4 bg-linear-to-r from-brand-red-500 to-brand-orange-500 hover:from-brand-red-600 hover:to-brand-orange-600 text-text-primary rounded-full transition-all duration-300 font-medium transform hover:scale-105 shadow-lg shadow-brand-red-500/25"
              aria-label="Visit YouTube channel"
            >
              <YoutubeIcon class="w-6 h-6" aria-hidden="true" />
              <span>{t(locale, "youtube.button")}</span>
            </a>
          </div>
        </>
      )}
    </div>
  </div>
</section>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
