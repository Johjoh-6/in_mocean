---
import { getCollection } from "astro:content";
import { t, type Locale } from "../translations";
import EventsCard from "./EventsCard.astro";
import { getIcon } from "../utils/icons";
import { parseDate } from "../utils/date";
import backgroundImageUrl from "../assets/background.jpeg";
import { getImage } from "astro:assets";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;

const basePath = locale === "en" ? "" : `/${locale}`;
const navEvents = `${basePath}/events`;

// get the 3 soonest events not already past
const events = (
	await getCollection("events", ({ data }) => {
		return parseDate(data.dateStart) > new Date();
	})
)
	.sort(
		(a, b) =>
			parseDate(a.data.dateStart).getTime() -
			parseDate(b.data.dateStart).getTime(),
	)
	.slice(0, 3);

const optimizedBackgroundImage = await getImage({ src: backgroundImageUrl });
const Calendar = getIcon("calendar");
---

<section
	id="events"
	class="relative min-h-screen"
	aria-labelledby="events-title"
>
	<div
		class="absolute inset-0 bg-cover bg-center bg-no-repeat"
		style={`background-image: url('${optimizedBackgroundImage.src}')`}
		role="img"
		aria-label="in_m'Ocean beach background"
	>
		<div class="absolute inset-0 bg-surface-body/75 backdrop-blur-[1px]">
		</div>
	</div>

	<div class="relative z-10 container mx-auto px-4 lg:px-8">
		<div class="text-center mb-16">
			<h2
				id="events-title"
				class="text-4xl md:text-5xl lg:text-6xl mb-6 gradient-events-heading font-bold leading-tight"
			>
				{t(locale, "events.title")}
			</h2>
			<p
				class="text-text-secondary text-lg md:text-xl max-w-2xl mx-auto leading-relaxed"
			>
				{t(locale, "events.description")}
			</p>
		</div>

		<!-- Events Grid -->
		<div class="max-w-6xl mx-auto mb-16">
			<div class="grid gap-8 md:gap-12">
				{
					events.length === 0 && (
						<div class="text-center py-16">
							<p class="text-text-muted text-2xl md:text-3xl lg:text-4xl">
								{t(locale, "events.futur")}
							</p>
						</div>
					)
				}
				{
					events.map((event, index) => (
						<EventsCard
							event={event.data}
							locale={locale}
							index={index}
						/>
					))
				}
			</div>
		</div>

		<div class="text-center">
			<a
				href={navEvents}
				class="inline-flex items-center gap-3 px-8 py-4 bg-linear-to-r from-brand-pink-500 to-brand-purple-600 text-text-primary rounded-full text-lg font-medium hover:from-brand-pink-600 hover:to-brand-purple-700 focus:from-brand-pink-600 focus:to-brand-purple-700 focus:outline-none focus:ring-4 focus:ring-brand-pink-500/30 transition-all duration-300 shadow-lg shadow-brand-pink-500/25 hover:shadow-xl hover:shadow-brand-pink-500/30 transform hover:-translate-y-1"
				aria-label={`${t(locale, "events.button")}`}
			>
				<Calendar class="w-5 h-5" aria-hidden="true" />
				{t(locale, "events.button")}
			</a>
		</div>
	</div>
</section>
