---
import { Image } from "astro:assets";
import imgReference from "../assets/logo.svg";
import { t, type Locale } from "../translations";
import MobileNav from "./MobileNav.svelte";

interface Props {
	locale: Locale;
	headerVisible?: boolean;
}

const { locale, headerVisible = false } = Astro.props;

const basePath = locale === "en" ? "" : `/${locale}`;

const navLinks = [
	{ href: `${basePath}/#about`, label: t(locale, "header.about") },
	{ href: `${basePath}/#music`, label: t(locale, "header.music") },
	{ href: `${basePath}/events`, label: t(locale, "header.events") },
	{ href: `${basePath}/#contact`, label: t(locale, "header.contact") },
];
---

<header
	id="header"
	class:list={[
		"fixed top-0 left-0 right-0 z-50 bg-black/90 backdrop-blur-md transition-all duration-300",
		{ "opacity-0": !headerVisible },
	]}
>
	<nav
		class="container mx-auto flex justify-between items-center px-6 py-4"
		aria-label="Main navigation"
	>
		<a href={`${basePath}/`} aria-label="Home">
			<Image src={imgReference} alt="Logo In_m'ocean" height={32} />
		</a>

		{/* Desktop nav */}
		<div class="hidden md:flex items-center gap-8">
			{
				navLinks.map((link) => (
					<a
						href={link.href}
						class="text-gray-300 hover:text-orange-400 focus:text-orange-400 focus:outline-none focus:ring-2 focus:ring-orange-400/50 rounded-sm px-1 py-0.5 transition-colors"
					>
						{link.label}
					</a>
				))
			}
		</div>

		{/* Mobile nav */}
		<MobileNav client:only="svelte" links={navLinks} />
	</nav>
</header>
