---
import { Image } from "astro:assets";
import Logo from "../assets/logo.avif";
import { t, type Locale } from "../translations";
import MobileNav from "./MobileNav.svelte";
import LocaleSelector from "./LocaleSelector.svelte";
import { locales, localizePathname } from "../utils/i18n";

interface Props {
	locale: Locale;
	headerVisible?: boolean;
}

const { locale, headerVisible = false } = Astro.props;

const basePath = locale === "en" ? "" : `/${locale}`;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const isActive = (href: string): boolean => {
	const cleanHref = href.replace(/\/$/, "") || "/";
	// Hash links (e.g. /#about) — not matchable server-side
	if (cleanHref.includes("#")) return false;
	return currentPath === cleanHref;
};

const navLinks = [
	{ href: `${basePath}/#about`, label: t(locale, "header.about") },
	{ href: `${basePath}/#music`, label: t(locale, "header.music") },
	{ href: `${basePath}/events`, label: t(locale, "header.events") },
	{
		href: `${basePath}/events/passed`,
		label: t(locale, "header.eventsPassed"),
	},
	{ href: `${basePath}/#contact`, label: t(locale, "header.contact") },
].map((link) => ({ ...link, active: isActive(link.href) }));

// Build locale options with localized URLs for the current page
const localeOptions = locales.map((l) => ({
	code: l.code,
	label: l.label,
	flag: l.flag,
	href: localizePathname(Astro.url.pathname, l.code),
}));
---

<header
	id="header"
	class:list={[
		"fixed top-0 left-0 right-0 z-50 bg-surface-overlay backdrop-blur-md transition-all duration-300",
		{ "opacity-0": !headerVisible },
	]}
>
	<nav
		class="container mx-auto flex justify-between items-center px-6 py-4"
		aria-label="Main navigation"
	>
		<a href={`${basePath}/`} aria-label="Home">
			<Image src={Logo} alt="Logo" class="w-8 h-8" />
		</a>

		{/* Desktop nav */}
		<div class="hidden md:flex items-center gap-8">
			{
				navLinks.map((link) => (
					<a
						href={link.href}
						class:list={[
							"rounded-sm px-1 py-0.5 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-orange-400/50",
							link.active
								? "text-brand-orange-400 border-b-2 border-brand-orange-400"
								: "text-text-secondary hover:text-brand-orange-400 focus:text-brand-orange-400",
						]}
						aria-current={link.active ? "page" : undefined}
					>
						{link.label}
					</a>
				))
			}

			{/* Desktop locale selector */}
			<LocaleSelector
				client:load
				currentLocale={locale}
				localeOptions={localeOptions}
			/>
		</div>

		{/* Mobile nav */}
		<MobileNav
			client:only="svelte"
			links={navLinks}
			currentLocale={locale}
			localeOptions={localeOptions}
		/>
	</nav>
</header>
