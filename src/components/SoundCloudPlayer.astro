---
import { SoundCloudOEmbed } from "../api/soundcloud-oembed";
import SoundCloudFacade from "./SoundCloudFacade.svelte";

interface Props {
	textPlay: string;
	url: string;
	title?: string;
	maxheight?: number;
	color?: string;
	auto_play?: boolean;
	show_comments?: boolean;
}

const {
	textPlay,
	url,
	title = "SoundCloud Track",
	maxheight = 166,
	color = "ff5500",
	auto_play = false,
	show_comments = true,
} = Astro.props;

const oembed = new SoundCloudOEmbed();
const embedData = await oembed.getEmbed(url, {
	maxheight,
	color,
	auto_play,
	show_comments,
});

// Extract iframe src from the oEmbed HTML so we can lazy-load it on click
let iframeSrc = "";
if (embedData?.html) {
	const srcMatch = embedData.html.match(/src="([^"]+)"/);
	if (srcMatch) {
		iframeSrc = srcMatch[1];
	}
}

// Thumbnail url is from soudcloud. It's a URL to a PNG image.
// https://soundcloud.com/images/fb_placeholder.png
// It never change, but maybe we can update it in soundcloud.com
const thumbnailUrl = embedData?.thumbnail_url || "";
---

{
	iframeSrc ? (
		<SoundCloudFacade
			client:visible
			textPlay={textPlay}
			iframeSrc={iframeSrc}
			iframeHeight={maxheight}
			title={title}
			thumbnailUrl={thumbnailUrl}
		/>
	) : (
		<div class="fallback bg-slate-800 rounded-lg p-6 text-center">
			<p class="text-gray-400 mb-4">Unable to load track</p>
			<a
				href={url}
				target="_blank"
				rel="noopener noreferrer"
				class="text-orange-400 hover:text-orange-300"
			>
				{title}
			</a>
		</div>
	)
}
