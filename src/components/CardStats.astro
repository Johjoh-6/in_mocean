---
import type { AstroComponent } from "@lucide/astro";

interface Props {
	icon: AstroComponent;
	value: string;
	label: string;
}

const { icon: Icon, value, label } = Astro.props;
---

<div
	class="group bg-linear-0-to-br from-surface-card-solid/50 via-surface-card-solid/30 to-surface-card backdrop-blur-sm p-6 rounded-xl border border-brand-orange-500/20 hover:border-brand-orange-500/50 hover:shadow-lg hover:shadow-brand-orange-500/10 transition-all duration-300 transform hover:-translate-y-1"
	role="article"
	aria-label={`${value} ${label}`}
>
	<Icon class="w-8 h-8 text-brand-orange-400 mb-3" aria-hidden="true" />
	<div class="text-2xl md:text-3xl font-bold text-text-primary mb-1">
		{value}
	</div>
	<div class="text-xs md:text-sm text-text-muted uppercase tracking-wide">
		{label}
	</div>
</div>
