---
interface Props {
	error: unknown;
}

const { error } = Astro.props;
---

<div class="text-center">
	<h1 class="text-9xl font-bold text-text-faint">404</h1>
	<p class="text-2xl font-light text-text-muted mt-4">Oops! Page not found</p>
	<p class="text-text-faint mt-4 mb-8">
		The page you are looking for might have been removed or is temporarily
		unavailable.
	</p>
	<a
		href="/"
		class="px-4 py-2 bg-brand-blue-400 text-text-primary rounded hover:bg-brand-blue-600 transition duration-300"
	>
		Go back to homepage
	</a>
</div>
