---
interface Props {
	error: unknown;
}

const { error } = Astro.props;
---

<div class="text-center">
	<h1 class="text-9xl font-bold text-brand-red-500">500</h1>
	<p class="text-2xl font-light text-text-muted mt-4">
		Internal Server Error
	</p>
	<p class="text-text-faint mt-4 mb-8">
		An unexpected error occurred on the server. Please try again later or
		contact support.
	</p>
	<a
		href="/"
		class="px-4 py-2 bg-brand-blue-400 text-text-primary rounded hover:bg-brand-blue-600 transition duration-300"
	>
		Go back to homepage
	</a>
</div>
