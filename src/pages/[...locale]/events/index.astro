---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import EventsCard from "../../../components/EventsCard.astro";
import { t, type Locale } from "../../../translations";
import { parseDate } from "../../../utils/date";
import backgroundImageUrl from "../../../assets/background.jpeg";
import { getImage } from "astro:assets";
import { getIcon } from "../../../utils/icons";

export const getStaticPaths = () => {
	return [
		{ params: { locale: undefined }, props: { locale: "en" } },
		{ params: { locale: "es" }, props: { locale: "es" } },
		{ params: { locale: "fr" }, props: { locale: "fr" } },
		{ params: { locale: "pt" }, props: { locale: "pt" } },
	];
};

const { locale } = Astro.props as { locale: Locale };
const basePath = locale === "en" ? "" : `/${locale}`;
const navEvents = `${basePath}/events/passed`;

const events = (
	await getCollection("events", ({ data }) => {
		return parseDate(data.dateStart) > new Date();
	})
).sort(
	(a, b) =>
		parseDate(a.data.dateStart).getTime() -
		parseDate(b.data.dateStart).getTime(),
);

const optimizedBackgroundImage = await getImage({ src: backgroundImageUrl });
const Calendar = getIcon("calendar");
---

<Layout
	locale={locale}
	title={`${t(locale, "events.title")} | in_m'Ocean`}
	headerVisible={true}
>
	<section
		class="relative min-h-screen pt-24 pb-16 flex flex-col gap-4"
		aria-labelledby="events-page-title"
	>
		<div
			class="absolute inset-0 bg-cover bg-center bg-no-repeat"
			style={`background-image: url('${optimizedBackgroundImage.src}')`}
			role="img"
			aria-label="in_m'Ocean beach background"
		>
			<div class="absolute inset-0 bg-slate-950/80 backdrop-blur-[1px]">
			</div>
		</div>

		<div class="relative z-10 container mx-auto px-4 lg:px-8">
			<div class="text-center mb-16">
				<h1
					id="events-page-title"
					class="text-4xl md:text-5xl lg:text-6xl mb-6 bg-linear-to-br from-pink-400 via-purple-400 to-blue-400 bg-clip-text text-transparent font-bold leading-tight"
				>
					{t(locale, "events.title")}
				</h1>
				<p
					class="text-gray-300 text-lg md:text-xl max-w-2xl mx-auto leading-relaxed"
				>
					{t(locale, "events.description")}
				</p>
			</div>

			<div class="max-w-6xl mx-auto">
				{
					events.length > 0 ? (
						<div class="grid gap-8 md:gap-12">
							{events.map((event, index) => (
								<EventsCard
									event={event.data}
									locale={locale}
									index={index}
								/>
							))}
						</div>
					) : (
						<div class="text-center py-16">
							<p class="text-gray-400 text-2xl md:text-3xl lg:text-4xl">
								{t(locale, "events.noevent") ??
									"No upcoming events at the moment."}
							</p>
						</div>
					)
				}
			</div>
		</div>
		<div class="text-center relative z-10 container mx-auto px-4 lg:px-8">
			<a
				href={navEvents}
				class="inline-flex items-center gap-3 px-8 py-4 bg-linear-to-r from-pink-500 to-purple-600 text-white rounded-full text-lg font-medium hover:from-pink-600 hover:to-purple-700 focus:from-pink-600 focus:to-purple-700 focus:outline-none focus:ring-4 focus:ring-pink-500/30 transition-all duration-300 shadow-lg shadow-pink-500/25 hover:shadow-xl hover:shadow-pink-500/30 transform hover:-translate-y-1"
				aria-label={`${t(locale, "events.buttonpassed")}`}
			>
				<Calendar class="w-5 h-5" aria-hidden="true" />
				{t(locale, "events.buttonpassed")}
			</a>
		</div>
	</section>
</Layout>
