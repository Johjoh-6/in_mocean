---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import EventsCard from "../../../components/EventsCard.astro";
import { t, type Locale } from "../../../translations";
import { parseDate } from "../../../utils/date";
import backgroundImageUrl from "../../../assets/background.jpeg";
import { getImage } from "astro:assets";

export const getStaticPaths = () => {
	return [
		{ params: { locale: undefined }, props: { locale: "en" } },
		{ params: { locale: "es" }, props: { locale: "es" } },
		{ params: { locale: "fr" }, props: { locale: "fr" } },
		{ params: { locale: "pt" }, props: { locale: "pt" } },
	];
};

const { locale } = Astro.props as { locale: Locale };

// Last to first sorting
const events = (
	await getCollection("events", ({ data }) => {
		return parseDate(data.dateStart) <= new Date();
	})
).sort(
	(a, b) =>
		parseDate(b.data.dateStart).getTime() -
		parseDate(a.data.dateStart).getTime(),
);

const optimizedBackgroundImage = await getImage({ src: backgroundImageUrl });
---

<Layout
	locale={locale}
	title={`${t(locale, "events.titlepassed")} | in_m'Ocean`}
	headerVisible={true}
>
	<section
		class="relative min-h-screen pt-24 pb-16 flex flex-col gap-4"
		aria-labelledby="events-page-title"
	>
		<div
			class="absolute inset-0 bg-cover bg-center bg-no-repeat"
			style={`background-image: url('${optimizedBackgroundImage.src}')`}
			role="img"
			aria-label="in_m'Ocean beach background"
		>
			<div
				class="absolute inset-0 bg-surface-body/80 backdrop-blur-[1px]"
			>
			</div>
		</div>

		<div class="relative z-10 container mx-auto px-4 lg:px-8">
			<div class="text-center mb-16">
				<h1
					id="events-page-title"
					class="text-4xl md:text-5xl lg:text-6xl mb-6 gradient-events-heading font-bold leading-tight"
				>
					{t(locale, "events.titlepassed")}
				</h1>
				<p
					class="text-text-secondary text-lg md:text-xl max-w-2xl mx-auto leading-relaxed"
				>
					{t(locale, "events.description")}
				</p>
			</div>

			<div class="max-w-6xl mx-auto">
				{
					events.length > 0 ? (
						<div class="grid gap-8 md:gap-12">
							{events.map((event, index) => (
								<EventsCard
									event={event.data}
									locale={locale}
									index={index}
									disabledCalendar
								/>
							))}
						</div>
					) : (
						<div class="text-center py-16">
							<p class="text-text-muted text-2xl md:text-3xl lg:text-4xl">
								{t(locale, "events.noeventpassed") ??
									"No passed events at the moment."}
							</p>
						</div>
					)
				}
			</div>
		</div>
	</section>
</Layout>
